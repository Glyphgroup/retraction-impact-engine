__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Secrets. The Cochrane bearer token lives only in the environment.
.env
secrets.json

# HTTP cache.
cache/

# Downloaded and fetched data. None of this is ours to redistribute, and the
# raw Cochrane payloads carry personal data (author names and email addresses)
# alongside the numbers. The reduced numeric fixture in tests/data is committed
# instead, and is regenerated by tools/make_cochrane_fixture.py.
# Scoped to the repository root so tests/data/ is still tracked.
/data/

# Cochrane's internal OpenAPI description, obtained from an authenticated
# session. Useful locally, not ours to publish.
swagger.json
spec.json
